# /etc/fc/fc.env (root:fc 0640). Quote values with spaces.
FC_SECRET_KEY=<random, 50+ chars>
FC_HOSTS=<domain>
FC_DB=/var/lib/fc/fc.sqlite3
FC_CACHE_DIR=/var/lib/fc/cache
FC_STATIC_ROOT=/opt/fc/static
FC_BRIDGE_SOCKET=/run/fc/bridge.sock
FC_FROM="fc <fc@<domain>>"
FC_SMTP_PASSWORD=<Resend API key>
# The base URL of this installation's miner builds, for the miner tab, as
# https://github.com/<owner>/<repo>/releases/latest/download. Empty: no tab.
FC_MINER_DOWNLOADS=
# The network's main CES server (host:port), which the sky draws in a style of
# its own. Empty: none.
FC_MAIN_SERVER=
# This installation's ledger, by its public address (host:port).
FC_LEDGER=<domain>:54000
# The grant to each new key in raw units, for the pages. The bridge gives it
# (FC_GRANT in bridge.env), so keep the two the same.
FC_GRANT=20000000000
