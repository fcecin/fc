[Unit]
Description=fc walk (maps the graph of the CES network)
After=fc-bridge.service fc-hub.service
Wants=fc-bridge.service

[Service]
Type=oneshot
User=fc
Group=fc
WorkingDirectory=/opt/fc/app
EnvironmentFile=/etc/fc/fc.env
ExecStart=/opt/fc/venv/bin/python manage.py fc_walk
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
ReadWritePaths=/var/lib/fc
