# Put your domain in place of <domain>. Caddy gets its own certificate.
<domain> {
	encode zstd gzip

	handle_path /static/* {
		root * /opt/fc/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The hub (fc-hub), with every page's WebSocket.
	handle /hub {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}

	log {
		output file /var/log/caddy/fc.log
	}
}
