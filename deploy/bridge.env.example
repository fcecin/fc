# /etc/fc/bridge.env (fc-keys 0600).
# The ledger's public address, and the address where the bridge reaches it.
FC_LEDGER=<domain>:54000
FC_HOME=127.0.0.1:54000
# The grant to each new key after its email code, in raw units (1 credit is
# 100000000). The ledger's own account refills to 2^46 raw units a day, so a
# grant of G credits serves at most 703687 / G new keys a day.
FC_GRANT=1000000000000
